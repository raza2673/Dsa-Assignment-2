#include <iostream>
using namespace std;

const int SIZE = 100;

struct PrintJob
{
    int jobId;
    int pages;
};

class Queue
{
private:
    PrintJob jobs[SIZE];
    int front;
    int rear;

public:
    Queue()
    {
        front = -1;
        rear = -1;
    }

    void enqueue(int jobId, int pages)
    {
        if (rear == SIZE - 1)
        {
            cout << "Queue Overflow!" << endl;
            return;
        }

        if (front == -1)
            front = 0;

        rear++;
        jobs[rear].jobId = jobId;
        jobs[rear].pages = pages;

        cout << "Job Added -> ID: " << jobId
             << ", Pages: " << pages << endl;
    }

    void display()
    {
        if (front == -1 || front > rear)
        {
            cout << "No Pending Jobs!" << endl;
            return;
        }

        cout << "
Pending Print Jobs:
";

        for (int i = front; i <= rear; i++)
        {
            cout << "Job ID: " << jobs[i].jobId
                 << ", Pages: " << jobs[i].pages << endl;
        }
    }
};

int main()
{
    Queue printerQueue;

    printerQueue.enqueue(101, 5);
    printerQueue.enqueue(102, 12);
    printerQueue.enqueue(103, 3);
    printerQueue.enqueue(104, 8);
    printerQueue.enqueue(105, 6);

    printerQueue.display();

    return 0;
}
